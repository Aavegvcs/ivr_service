NODE_ENV=development
PORT=5200

# Auth
API_KEY=change-me-internal-api-key
WEBHOOK_TOKEN=change-me-exotel-webhook-token

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=ivr
DB_PASSWORD=ivr
DB_NAME=ivr_service
# Auto-create tables (dev only). Use migrations in production.
DB_SYNCHRONIZE=true

# Masking rules
DEFAULT_COUNTRY_CODE=91
SESSION_TTL_MINUTES=60
MAX_CALL_DURATION_SECONDS=3600
RECORD_CALLS=false
