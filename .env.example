NODE_ENV=development
PORT=5200

# Auth
API_KEY=change-me-internal-api-key
WEBHOOK_TOKEN=change-me-exotel-webhook-token


# Masking rules
DEFAULT_COUNTRY_CODE=91
SESSION_TTL_MINUTES=60
MAX_CALL_DURATION_SECONDS=3600
# How long the other phone rings before giving up (Exotel: 20-60 recommended)
RING_TIMEOUT_SECONDS=20
RECORD_CALLS=true

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=ivrmicroserivce
